    },
    {
      "id": "epic",
      "label": "Epic Games",
      "probeKind": "tcpConnect",
      "endpoints": [{ "id": "store", "address": "store.epicgames.com", "port": 443 }]
    },
    {
      "id": "riot",
      "label": "Riot Games",
      "probeKind": "tcpConnect",
      "endpoints": [{ "id": "web", "address": "www.riotgames.com", "port": 443 }]
    }
